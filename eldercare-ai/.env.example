# Copy to .env and edit. Never commit .env.
# AI is OFF by default. The app is fully functional in Demo Mode without a key.
DEMO_MODE=true
DB_PATH=data/eldercare.db
LOG_LEVEL=INFO

# Optional cloud LLM. Leave AI_PROVIDER=local to run with local ML only.
AI_PROVIDER=local          # local | gemini
GEMINI_API_KEY=
# Confirm the current model id in Google AI Studio; a wrong id fails safely without retries.
GEMINI_MODEL=gemini-3.5-flash-lite

# Request protection (all calls are manual, one per user message)
AI_DAILY_LIMIT=20
AI_MIN_INTERVAL_SECONDS=5
AI_CACHE_TTL_HOURS=24
AI_QUOTA_COOLDOWN_MINUTES=30
